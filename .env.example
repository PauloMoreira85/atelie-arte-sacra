# ─── Asaas (pagamentos) ──────────────────────────────────────────────────────
#
# ⚠️  ATENÇÃO: a chave da Asaas começa com "$". O cifrão é interpretado como
#     variável em arquivos .env, então a chave PRECISA estar entre ASPAS
#     DUPLAS, senão ela chega vazia no servidor e o pagamento não abre.
#
#     ✅ certo:  ASAAS_API_KEY="$aact_hmlg_000000..."
#     ❌ errado: ASAAS_API_KEY=$aact_hmlg_000000...
#
# Onde gerar: Asaas > Configurações > Integrações > Chave de API
#   - Sandbox (testes): crie a conta em https://sandbox.asaas.com
#     A chave começa com $aact_hmlg_ e o ambiente é detectado sozinho.
#   - Produção: use a chave da sua conta real.
#
# Enquanto estiver vazia, o site funciona normalmente e o checkout avisa o
# cliente para finalizar pelo WhatsApp.
ASAAS_API_KEY=""

# Opcional. Força o ambiente: "sandbox" ou "producao".
# Se não preencher, detectamos pela própria chave.
ASAAS_AMBIENTE=

# ─── Melhor Envio (frete) ────────────────────────────────────────────────────
# Token gerado em: melhorenvio.com.br > Gerenciar > Tokens > Novo Token
# Permissao minima necessaria: "Cotacao de fretes" (shipping-calculate)
# Enquanto vazio, o site usa o frete fixo de LOJA.freteFixo.
MELHOR_ENVIO_TOKEN=""

# "sandbox" para testes, vazio ou "producao" para valer
MELHOR_ENVIO_AMBIENTE=""

# CEP de onde as encomendas sao postadas (so digitos). OBRIGATORIO para cotar.
# 87013000 = Av. Brasil 4312, Centro, Maringa/PR — mesmo endereco de
# expedicao dos outros projetos. As pecas sao feitas em Colatina-ES, mas o
# envio (e a nota) saem de Maringa.
CEP_ORIGEM="87013000"

# E-mail de contato exigido pelo Melhor Envio no cabecalho User-Agent
EMAIL_CONTATO=""

# ─── Supabase (painel de administração) ──────────────────────────────────────
# Projeto: atelie-arte-sacra
# As duas primeiras sao publicas (vao para o browser). A SERVICE_ROLE e
# SECRETA: da acesso total ao banco, nunca comitar nem expor no cliente.
# Pegue em: Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://ynrlolxcgjhtzllolxrk.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Rastreamento de anúncios (Google e Meta) ────────────────────────────────
# Todos públicos (vão para o browser). Cada ferramenta só carrega se o ID
# dela estiver preenchido; vazio = desligada. Detalhes e lista de eventos em
# COMO-EDITAR.md > Rastreamento de anúncios.
#
# GA4: Google Analytics > Administrador > Fluxos de dados > ID da métrica
NEXT_PUBLIC_GA4_ID=""            # ex.: G-XXXXXXXXXX
# Google Ads: Metas > Conversões > (ação de compra) > Configuração da tag
#   ID da conta ("AW-...") e o rótulo da conversão de compra (depois da "/")
NEXT_PUBLIC_GADS_ID=""           # ex.: AW-123456789
NEXT_PUBLIC_GADS_PURCHASE_LABEL="" # ex.: AbCdEfGhIjKlMnOp
# Meta: Gerenciador de Eventos > Fontes de dados > (pixel) > ID (só números)
NEXT_PUBLIC_META_PIXEL_ID=""     # ex.: 1234567890123456

# ── Webhook da Asaas ────────────────────────────────────────────────────────
# Confirma o pagamento e busca o endereço de entrega (a tela da Asaas é quem
# coleta rua e número). Sem isto, nenhum pedido sai de "aberto".
#
# Gere um valor aleatório e cole o MESMO nos dois lugares:
#   Asaas → Integrações → Webhooks → Token de autenticação
#   aqui e no Vercel
ASAAS_WEBHOOK_TOKEN=""

# ── Base by Asaas (NF-e) ────────────────────────────────────────────────────
# Painel SEPARADO do Asaas, mesmo CNPJ (PCS Moreira). A chave do Asaas NÃO
# funciona aqui — dá 403.
#
# ⚠️ A chave começa com "$": escape o cifrão, como na do Asaas.
BASE_API_KEY=""
BASE_AMBIENTE="producao"
